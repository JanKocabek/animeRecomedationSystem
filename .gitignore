# General Project Files
# Ignore documentation, help files, and environment configs that shouldn't be committed
HELP.md
docs/tasks.md
*.env
secrets/
utils/load_data.sh

# Build Artifacts and Tools
# Ignore compiled outputs and build directories to keep the repo clean
target/
build/
# Exceptions: Allow specific subdirectories under src for custom builds
!**/src/main/**/target/
!**/src/test/**/target/
!**/src/main/**/build/
!**/src/test/**/build/
# Maven wrapper files – these are machine-specific and can be regenerated
.mvn/wrapper/maven-wrapper.jar
.mvn/wrapper/maven-wrapper.properties

# IDE and Editor Configurations
# Ignore files generated by IDEs to avoid committing personal settings

### STS/Eclipse ###
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache

### IntelliJ IDEA ###
.idea/
*.iws
*.iml
*.ipr

### NetBeans ###
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

### VS Code ###
.vscode/

# Frontend and Development Assets
# Ignore source maps, styles, and compiled assets for web development (e.g., Sass, Bootstrap)
src/main/resources/static/assets/scss/
*.map
*.scss
src/main/resources/static/assets/css/material-kit.css
src/main/resources/static/assets/js/material-kit.js

# Logs and Temporary Files
# Ignore runtime logs and temp directories
/logs/
advice/*

# Database and Backup Files
# Ignore SQL dumps, sessions, and config backups to prevent sensitive data commits
ProgramResources/backup-db.sql
Animerecommendationsystem.session.sql
src/main/resources/application.properties_backup

# Large Resources and Archives
# Ignore heavy datasets and zips – these can be downloaded or generated separately
ProgramResources/anime-dataset-2023.csv.zip
ProgramResources/archive.zip
*tar

# Miscellaneous
# Catch-all for project-specific files that don't fit other categories
ProgramResources/RestPointController.java

